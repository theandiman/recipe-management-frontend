# Local environment variables for dev
# Copy to .env.local and adjust values as needed

# Backend API base (AI service); used by the app (postWithAuth thunks)
VITE_API_URL=http://localhost:8080

# Management service API
VITE_MANAGEMENT_API_URL=http://localhost:8081

# Tailwind / vite dev
# Vite dev server settings are in vite.config.ts (proxy /api -> http://localhost:8080)
